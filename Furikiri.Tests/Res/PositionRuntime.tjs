function apply(actions, skip, hidden) {
    var trace="", seen=%[];
    var count=actions!==void?actions.count:0;
    for(var i=0;i<count;i++) {
        var item=actions[i];
        if(item===void) {trace+="V";continue;}
        if(typeof item=="Integer") {trace+="I";continue;}
        var name=item[0], value=item[1];
        if((value instanceof "Array" && !skip) || (value!==void && !hidden)) {
            if(!seen[name] || value===void) {trace+="D";seen[name]=1;}
            if(value instanceof "Array") {trace+="A";continue;}
            if(value!==void && typeof value!="Object") {
                if(typeof value!="String") {
                    var x=item.count>2?item[2]:0;
                    var y=item.count>3?item[3]:0;
                    trace+=name+":"+value+":"+x+":"+y+";";
                    continue;
                }
                if(value.charAt(0)=="#") trace+=value.substr(1);
            }
        }
    }
    return trace;
}
