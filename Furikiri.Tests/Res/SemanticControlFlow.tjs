class SemanticControlFlow
{
    var owner;
    var number;

    function guard(layer, arg)
    {
        if (arg === void || (typeof layer.isBitmap == "Object" && !layer.isBitmap()))
            return;
        layer.accepted = 1;
    }

    function position(arg)
    {
        if (arg !== void && arg.pos !== void)
        {
            left = arg.pos;
            top = 1;
        }
        else
        {
            if (arg.left !== void) left = arg.left;
            if (arg.top !== void) top = arg.top;
        }
    }

    function mode(arg)
    {
        switch (arg.mode)
        {
        case "":
        case "pile":
        case "alpha":
            holdAlpha = 0;
            face = dfAlpha;
            break;
        case "addalpha":
            holdAlpha = 0;
            face = dfAddAlpha;
            break;
        default:
            holdAlpha = 1;
            face = dfOpaque;
            break;
        }
        done = 1;
    }

    function callOnce(fn, arg)
    {
        return fn(arg);
    }

    function collapseNames(first, rest*)
    {
        var firstLocal = first;
        var count = rest.count;
        return firstLocal + count;
    }

    function cleanup(obj, hook)
    {
        if (hook !== void && isvalid obj)
            obj.removeHook(hook);
        term();
        finish();
    }

    function options(text, list)
    {
        if (text !== void && text.charAt(0) == ";" && text.charAt(1) == "!")
        {
            for (var i = 0; i < list.count; i++)
                list[i] = "." + list[i] + (list[i].indexOf("=") < 0 ? "=true" : "");
            commit(list);
        }
        after();
    }

    function optionalReturn(flag)
    {
        if (flag !== void && +flag)
            act();
        return -4;
    }

    function nestedDefault(flag, value)
    {
        angle = value === void ? flag ? 2700 : 0 : +value;
    }

    function nestedChoice(outer, first, left, right)
    {
        selected = outer ? first : ((left <= right) ? left : right);
    }

    function nestedBoolean(first, second, third)
    {
        return first || (second && third);
    }

    function nullGuard(value)
    {
        if (value == null)
            return 1;
        return 0;
    }

    function bitwiseMask(style, vertical, horizontal)
    {
        style &= ~(vertical | horizontal);
        return style;
    }

    function memberDefaults(data)
    {
        if (data.top === void) data.top = 0;
        if (data.left === void) data.left = 0;
        if (data.right === void) data.right = 0;
    }

    function sharedCases(vertical, key)
    {
        if (vertical)
        {
            if (key == KEY_DOWN) down();
            else if (key == KEY_UP) up();
            else if (key == KEY_LEFT || key == KEY_PRIOR) previous();
            else if (key == KEY_RIGHT || key == KEY_NEXT) next();
        }
        else
        {
            if (key == KEY_LEFT || key == KEY_PRIOR) previous();
            else if (key == KEY_RIGHT || key == KEY_NEXT) next();
        }
    }

    function nestedEqualityDispatch(kind, target)
    {
        if (kind == "click")
        {
            if (target == TARGET_YES) first();
            else if (target == TARGET_NO) second();
        }
        else if (kind == "key")
        {
            third();
        }
    }


    function groupedSwitch(mode, flag)
    {
        switch (mode)
        {
        case 0:
            if (flag) first();
            break;
        case 1:
        case 2:
            if (flag) second();
            else third();
            break;
        }
        afterSwitch();
    }

    function switchLoop(number, digits, smallUnits, largeUnits)
    {
        var out = "";
        var nonzero = false;
        var position = number.length - 1;
        for (var i = 0; i < number.length; i++, position--)
        {
            var unit = position & 3;
            var digit = +number[i];
            switch (unit)
            {
            case 0:
                if (digit != 0) out += digits[digit], nonzero = true;
                if (nonzero && position) out += largeUnits[position >> 2];
                nonzero = false;
                break;
            case 1:
            case 2:
            case 3:
                if (digit != 0)
                {
                    if (digit != 1 || (unit == 3 && position > 4))
                        out += digits[digit] + smallUnits[unit];
                    else
                        out += smallUnits[unit];
                    nonzero = true;
                }
                break;
            }
        }
        return out;
    }

    function equalityDefault(text, digits, point, minus)
    {
        var out = "";
        for (var i = 0; i < text.length; i++)
        {
            var ch = text[i];
            if (ch == ".") out += point;
            else if (ch == "-") out += minus;
            else if (ch >= "0" && ch <= "9") out += digits[+ch];
            else out += ch;
        }
        return out;
    }

    function delayedForInitializer(items)
    {
        var total = 0;
        var i = 0;
        var count = items.count;
        for (; i < count; i++)
        {
            if (items[i] == "") continue;
            total++;
        }
        return total;
    }

    function assignmentConditionLoop(items)
    {
        var i = 0;
        var item;
        var total = 0;
        while ((item = items[i++]) !== void)
        {
            if (item == "stop")
            {
                touch();
                break;
            }
            if (item == "") continue;
            total++;
        }
        return total;
    }

    function assignmentShortCircuitGuard(items)
    {
        var accepted = 0;
        for (var i = items.count - 1; i >= 0; i--)
        {
            var target = items[i], name;
            if (target && (name = target.name) != "")
            {
                consume(target);
                accepted++;
            }
        }
        return accepted;
    }

    function assignedReturnGuard(target, table)
    {
        var states;
        if (target == "" || table[target] === void ||
            (states = table[target].states) === void)
            return;
        consume(states);
    }

    function conditionalLatchLoop(items)
    {
        var i = 0;
        var count = items.count;
        while (i < count)
        {
            var removed = false;
            if (items[i] == "drop")
            {
                items.erase(i);
                removed = true;
            }
            if (removed) count--;
            else i++;
        }
        return count;
    }

    function compoundDoWhile(items, limit)
    {
        var i = 0;
        do
        {
            i++;
        }
        while (i < limit && items[i] == "");
        return i;
    }

    function emptySwitchCase(items)
    {
        for (var i = 0; i < items.count; i++)
        {
            var value = items[i];
            switch (value)
            {
            case "\\":
                break;
            case "k":
                accept(value);
            default:
                continue;
            }
            after(value);
        }
    }

    function guardedDelete(table, key)
    {
        if (typeof key == "String")
        {
            if (table[key] !== void)
                delete table[key];
            consume(key);
        }
    }

    function loopShortCircuitBody(items, value, all)
    {
        var i = 0;
        while (i < items.count)
        {
            var item = items[i];
            var isTick = typeof value == "Integer";
            var isNumber = typeof item.run == "Integer";
            if (all ||
                (value === void && !item.done) ||
                item.run === void ||
                (isTick && isNumber && item.run - value <= 0) ||
                (!isTick && !isNumber && (item.run == value || value == "*")))
            {
                mark(item);
                if (!interrupted)
                {
                    if (timerEnabled) queued(item);
                    else direct(item);
                }
            }
            i++;
        }
    }

    function sideEffectGuard(off, on)
    {
        if ((off && setVisible(false)) || (on && setVisible(true)))
            return -3;
        afterVisibility();
        return 0;
    }

    function sideEffectWithGuard(context, off, on)
    {
        with (context)
        {
            if ((off && setVisible(false)) || (on && setVisible(true)))
                return -3;
        }
        afterVisibility();
        return 0;
    }

    function initializedSideEffectGuard(context, mode)
    {
        var off = false, on = false;
        if (mode == 1) off = true;
        else if (mode == 2) on = true;
        else
        {
            off = context.off;
            on = context.on;
        }
        if ((off && setVisible(false)) || (on && setVisible(true)))
            return -3;
        afterVisibility();
        return 0;
    }

    function multiWayNoDefault(kind)
    {
        if (kind == 1) first();
        else if (kind == 2) second();
        afterChoice();
    }

    function gatedMultiWay(enabled, kind)
    {
        if (enabled)
        {
            if (kind == 1) first();
            else if (kind == 2) second();
        }
        afterChoice();
    }

    function tryThenElseChoice(kind)
    {
        if (kind == 1)
        {
            try
            {
                first();
            }
            catch (e)
            {
                failed(e);
            }
        }
        else if (kind == 2)
        {
            second();
        }
        afterChoice();
    }

    function nestedReverseLoops(items)
    {
        var total = 0;
        for (var i = items.count - 1; i >= 0; i--)
        {
            if (items[i] == "") continue;
            var sub = items[i];
            if (typeof sub == "Object")
            {
                for (var j = sub.count - 1; j >= 0; j--)
                {
                    if (sub[j] != "") total++;
                }
            }
        }
        return total;
    }

    function rangeBreak(text)
    {
        var count = 0;
        for (var i = 0; i < text.length; i++)
        {
            var ch = text[i];
            if (ch >= "0" && ch <= "9") count++;
            else if (ch == "." || ch == "e") break;
        }
        return count;
    }

    function longDictionary()
    {
        handlers = %["pimage" => SemanticControlFlow.loadPartialImage,
                     "ptext" => SemanticControlFlow.drawReconstructibleText];
    }

    function mixedShortCircuit(name, eye, lip)
    {
        if (name === void || name == "" ||
            (name.substr(0, 3) == "eye" && +name.substr(3) == eye) ||
            (name.substr(0, 3) == "lip" && +name.substr(3) == lip))
            accept(name);
    }

    function objectMemberGuard(links, index)
    {
        var target = links[index].object;
        if (target === void || !isvalid target || (target.visible && target.enabled))
            return index;
        return -1;
    }

    function constructorMember(data)
    {
        consume((new PSBFile(data)).root);
    }

    function guardedAlternative(ext, expected, storage)
    {
        if ((ext != "" && expected == ext) ||
            (ext == "" && probe(storage) != ""))
            return 1;
        return 0;
    }
}
