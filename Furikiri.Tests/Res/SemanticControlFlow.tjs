        if (stop)
            return finishShared(value);
        consumeOne(value);
        return finishShared(value);
    }

    function validationSingleCaseSwitch(value)
    {
        switch (typeof value)
        {
        case "String":
            return consumeOne(value);
        default:
            return value;
        }
    }

    function validationSingleCaseBreakSwitch(value)
    {
        var result = void;
        switch (typeof value)
        {
        case "String":
            result = consumeOne(value);
            break;
        }
        return result;
    }

    function validationSingleCaseSwitchContainingIf(value)
    {
        switch (typeof value)
        {
        case "String":
            if (value == "target")
                consumeOne(value);
            break;
        }
        consumeOther(value);
    }

    // 内层单 case switch 拥有自己的 case/default 两级收尾，不能因为受外层
    // 多 case switch 支配就被降级成普通 if。
    function validationNestedSingleCaseDefaultSwitch(value)
    {
        switch (value.kind)
        {
        case "first":
            switch (value.level)
            {
            case 0:
                consumeOne(value);
                break;
            default:
                consumeTwo(value);
                break;
            }
            break;
        case "second":
            consumeOther(value);
            break;
        }
    }

    // default 与一个具名 case 共用正文时，该 case 条件的真假边会落到同一块；
    // 标签仍必须保留，不能被当作无语义跳板折叠。
    function validationDefaultSharingCaseBody(value)
    {
        switch (value.kind)
        {
        case "outer":
            switch (value.align)
            {
            case "right":
                consumeOne(value);
                break;
            default:
            case "left":
                consumeTwo(value);
                break;
            }
            break;
        case "other":
            consumeOther(value);
            break;
        }
    }

    function validationMultiCaseSwitchContainingIf(value)
    {
        switch (value.kind)
        {
        case "first":
            if (value.state == "yes")
                consumeOne(value);
            else if (value.state == "no")
                consumeTwo(value);
            break;
        case "second":
            consumeOther(value);
            break;
        }
    }

    // 同一个缓存计算式上的普通 if 不应仅凭一个 CEQ 被猜成 switch。
    function validationEquivalentComputedIf(value)
    {
        if (typeof value == "String")
            return consumeOne(value);
        return value;
    }

    // 外层普通 if 的正文中即使包含真正的 switch，也不能把内层 switch 的
    // 不可达收尾跳转误认为外层单 case switch 的来源证据。
    function validationComputedIfContainingSwitch(value)
    {
        if (typeof value == "String")
        {
            switch (value)
            {
            case "first":
                consumeOne(value);
                break;
            case "second":
                consumeTwo(value);
                break;
            }
        }
        else
        {
            consumeOther(value);
        }
    }

    // 连续 case 可以共享同一个 return 正文；最后一个比较不能先被恢复成
    // “失败就空返回”的局部叶子，否则前一个标签到正文的跳板会一起丢失。
    function validationSharedTerminalTypeCases(value)
    {
        switch (typeof value)
        {
        case "String":
            return parseString(value);
        case "Integer":
        case "Real":
            return makeNumber(value);
        }
    }

    // 前置循环退出守卫不能抢先吞掉后面的完整类型分派。
    function validationGuardedTypeSwitch(items)
    {
        var index = 0;
        var item;
        while ((item = items[index++]) !== void)
        {
            if (typeof item == "Object" && item.stop) break;
            switch (typeof item)
            {
            case "Integer":
                consumeInteger(item);
                break;
            case "String":
                consumeString(item);
                break;
            }
        }
    }

    // 不相交语句块可以复用同一 VM 槽，但两个 var 仍属于不同的词法作用域。
    function validationBlockScopedSlotReuse(flag)
    {
        if (flag)
        {
            var branchValue = makeBranchValue();
            consume(branchValue);
        }
        var followingValue = makeFollowingValue();
        consume(followingValue);
    }

    // for 初始化节有独立作用域；循环结束后复用槽位的变量仍需重新声明。
    function validationForScopedSlotReuse(items)
    {
        for (var loopValue = 0; loopValue < items.count; loopValue++)
        {
            consume(items[loopValue]);
        }
        var followingValue = makeFollowingValue();
        consume(followingValue);
    }

    // 多路入口共享的短路尾项只应保留一次，不能在条件 Phi 两臂中复制调用。
    function validationFactoredBooleanPhi(gate, first, second, tail, cached)
    {
        var result = gate && (first || second) && tail && (cached || probe());
        consume(result);
    }

    // 三路值 Phi 的短路守卫不能因内层路径汇合而丢失。
    function validationGuardedNestedTernary(fixCamera, level, env)
    {
        var selected = fixCamera
            ? (env.cameraZoom > 100 && level < env.levels.count - 1
                ? level + 1 : level)
            : level;
        consume(selected);
    }

    // 动态索引之后继续访问多层成员时，外层标识符不能截断复合接收者。
    function validationNestedDynamicMember(table)
    {
        return table[0].core.currentPageName;
    }

    // 返回 flag 的三路调用 Phi 必须保留最外层守卫和公共回退调用。
    function validationGuardedCallableReturn(enabled, getState)
    {
        return (enabled && (getState(KEY_RETURN) || getState(KEY_SPACE))) ||
            getState(KEY_CONTROL);
    }

    // 首个 case 为空时，default 不能吞掉这个显式“不处理”分支。
    function validationLeadingEmptyCase(style, mode)
    {
        switch (mode)
        {
        case MODE_NONE:
            break;
        case MODE_HORIZONTAL:
            style |= STYLE_HORIZONTAL;
            break;
        case MODE_VERTICAL:
            style |= STYLE_VERTICAL;
            break;
        default:
        case MODE_BOTH:
            style |= STYLE_HORIZONTAL | STYLE_VERTICAL;
            break;
        }
        return style;
    }

    // 属性赋值仍是一个有返回值的表达式；后续调用必须消费被写入的同一个对象，
    // 不能重新构造一个文本相同但身份不同的临时值。
    function validationAssignedValueReceiver(target, source, index)
    {
        (target.values = []).assign(source.values);
        (Dictionary.assign incontextof (target[index] = %[]))(source[index]);
        (target.node = makeNode()).consume(source);
    }

    // with 控制对象会跨越条件块存活，其创建结果仍只能求值一次。
    function validationCrossBlockReceiver(target, flag)
    {
        with (target.shared = makeNode())
        {
            if (flag) .first();
            .second();
        }
    }

    // 循环内的析取守卫可能有多条路径命中同一个提前返回；后一条路径中的
    // 调用不能被局部的两段守卫恢复误当成公共尾部而丢失。
    function validationAlternativeProbe(entries, ext, storage)
    {
        for (var i = 0, type; i < entries.count; i++)
        {
            type = entries[i].type;
            if (type == "") continue;
            var entry = entries[i];
            switch (typeof entry.ext)
            {
            case "String":
                if ((ext != "" && entry.ext == ext) ||
                    (ext == "" && probe(storage, entry.ext) != "")) return type;
                break;
            case "Object":
                if ((ext != "" && entry.ext.find(ext) >= 0) ||
                    (ext == "" && probe(storage, entry.ext*) != "")) return type;
                break;
            }
            if (checker(entry)) return type;
        }
    }

    // 带调用的共享入口赋值只能求值一次；中间多块守卫的
    // continue 不能让后续公共处理漏到守卫体内或反过来。
    function validationCachedLoopBranch(source, autoMode)
    {
        var value;
        for (;;)
        {
            if (source.count > 0)
            {
                value = source.shift();
            }
            else
            {
                value = nextValue();
                if (value !== void)
                {
                    if (autoMode) consume(value);
                    if (skipValue(value)) continue;
                    if (targetLine !== void)
                    {
                        if (value.line > targetLine ||
                            (value.line >= targetLine && value.count >= targetCount))
                        {
                            mark(value);
                            if (stopValue(value)) return value;
                        }
                        continue;
                    }
                    if (source.count > 0)
                    {
                        source.add(value);
                        continue;
                    }
                }
            }
            consumeFinal(value);
        }
    }

    // 某个分派臂无论内部条件是否命中都会结束本轮；内层可选日志不能独占
    // continue，未进入更新分支时也不能落入同层公共处理。
    function validationLoopIterationCompletion(pendings, verbose)
    {
        for (;;)
        {
            var item = pendings.shift();
            if (item.kind == "line")
            {
                if (currentLine != item.line)
                {
                    currentLine = item.line;
                    currentCount = 0;
                    if (verbose && debugLevel > 0) trace(item);
                }
                continue;
            }
            if (item.kind == "count")
            {
                currentCount++;
                continue;
            }
            consumeFinal(item);
        }
    }

    // do-while 的短路尾条件会分布在多个基本块中；正文内清除目标值的赋值
    // 必须仍受原条件控制，不能被提升到循环条件之外。
    function validationCompoundDoWhileTarget(pendings)
    {
        var i = 0, item;
        do
        {
            item = pendings[i++];
            if (item.line > targetLine ||
                (item.line >= targetLine && item.count >= targetCount))
            {
                targetLine = void;
            }
        }
        while (i < pendings.count && targetLine != void);
        consumeFinal(i);
    }

    // 两段短路条件命中后先执行载荷再 break。退出块不属于自然循环集合，
    // 仍必须保留为循环转移，不能因它最终到达函数末尾而当成普通汇合路径。
    function validationLoopGuardedPayloadBreak(children, value)
    {
        for (var i = children.count - 1; i >= 0; i--)
        {
            var item = children[i];
            if (typeof item.speed !== "undefined" && item.speed == value)
            {
                item.checked = true;
                break;
            }
        }
    }

    // 多个 case 都可能在条件成立时提前返回，条件失败则 break 到同一个公共尾部。
    // 公共尾部不能被最先处理的 case 独占，否则其他 case 会丢失 break 和后续调用。
    function validationSwitchConditionalReturnAndContinuation(key, vertical)
    {
        switch (key)
        {
        case 1:
            if (vertical) return stepLeft();
            break;
        case 2:
            if (!vertical) return stepRight();
            break;
        case 3:
            return moveHead();
        }
        finishMove();
    }

    // 外层 case 标签与共享正文中的三元判断读取同一个源码变量，但属于两次
    // 独立的 VM 求值；正文条件不能被误当成外层分派的另一个标签。
    function validationSharedCaseBodyWithIndependentPhi(mode)
    {
        var style = 0;
        switch (mode)
        {
        case 1:
        case 2:
            style |= (mode == 1) ? 4 : 8;
            style |= 16;
            break;
        case 3:
            style |= 32;
            break;
        default:
            style = -1;
            break;
        }
        return style;
    }

    // 成员写入与后续读取是两个可观察操作；即使右值很简单，
    // 也不能把判断改成对赋值表达式右值的直接比较。
    function validationMemberAssignmentRead(value)
    {
        memberAssignmentState = value;
        if (memberAssignmentState === void) return 0;
        return 1;
    }

    // 多个顺序更新各自使用共享载荷的短路 OR。后一条 guard 不是前一条 OR 的
    // 分支正文，但也不能导致前一条条件被拆成反向 AND。
    function validationSequentialShortCircuitUpdates(target, source)
    {
        if (target.x === void || target.x > source.x)
            target.x = source.x;
        if (target.y === void || target.y > source.y)
            target.y = source.y;
        if (target.x2 === void || target.x2 < source.x2)
            target.x2 = source.x2;
        if (target.y2 === void || target.y2 < source.y2)
            target.y2 = source.y2;
    }

    // 多个 switch case 的 guard 失败路径共用函数末尾隐式 return。每个 case
    // 仍拥有自己的 break，default 正文中的嵌套双载荷判断也必须先完整物化。
    function validationSwitchGuardedSharedVoid(mode, target, kind)
    {
        switch (mode)
        {
        case 1:
            if (target !== void)
            {
                var values = [];
                switch (kind)
                {
                case "empty":
                    break;
                default:
                    if (target.face != "")
                    {
                        if (target.face.indexOf(":"))
                        {
                            var parts = target.face.split(":");
                            for (var i = 0; i < parts.count; i++)
                                values.add(parts[i]);
                        }
                        else
                        {
                            values.add(target.face);
                        }
                    }
                    break;
                }
                return consume(values);
            }
            break;
        case 2:
            if (target !== void)
                return consume(target);
            break;
        }
    }

    // 空分支经独立 JMP 跳板直达函数末尾时，另一臂中的完整嵌套判断仍必须
    // 受最外层对象存在性条件保护，不能被提升成无条件执行。
    function validationEmptyBranchAroundNested(target, mode)
    {
        if (target == null)
        {
        }
        else
        {
            if (mode)
                target.accept();
            else
                target.reject();
        }
    }

    // 特殊实数必须按各自的 IEEE-754 位模式进入常量池，并恢复为规范关键字。
    function validationSpecialRealConstants(kind)
    {
        switch (kind)
        {
        case 0: return NaN;
        case 1: return Infinity;
        case 2: return -Infinity;
        }
        return 1.25;
    }

    // 属性对象经过 incontextof 改绑后，读写必须分别保留 GETP/SETP 的一元 * 语义。
    property forwardedValue
    {
        getter()
        {
            return *(&global.SemanticControlFlow.sharedValue incontextof this);
        }
        setter(value)
        {
            *(&global.SemanticControlFlow.sharedValue incontextof this) = value;
        }
    }

    property sharedValue
    {
        getter() { return owner; }
        setter(value) { owner = value; }
    }
}

// 嵌套类必须作为外层类的成员写出，不能提升成同名全局类。
class ValidationNestedOwner
{
    class Child
    {
        function getValue()
        {
            return 7;
        }
    }

    function createChild()
    {
        return new ValidationNestedOwner.Child();
    }
}

// 属性名只在所属类内唯一，两个类的同名属性都必须保留。
class DuplicatePropertyOwner
{
    var stored;

    property sharedValue
    {
        getter() { return stored; }
        setter(value) { stored = value; }
    }
}

// 顶层显式块中的 var 是局部槽，不能展平为全局对象成员。
{
    var topLevelScopeProbe = System.getArgument("-furikiri-scope-probe");
    if (topLevelScopeProbe !== void)
    {
        Debug.message(topLevelScopeProbe);
    }
}
