class SemanticControlFlow
{
    var owner;
    var number;
    var chainOuter;
    var chainInner;
    var cached;
    var pendingState;
    var memberAssignmentState;

    function guard(layer, arg)
    {
        if (arg === void || (typeof layer.isBitmap == "Object" && !layer.isBitmap()))
            return;
        layer.accepted = 1;
    }

    function position(arg)
    {
        if (arg !== void && arg.pos !== void)
        {
            left = arg.pos;
            top = 1;
        }
        else
        {
            if (arg.left !== void) left = arg.left;
            if (arg.top !== void) top = arg.top;
        }
    }

    function mode(arg)
    {
        switch (arg.mode)
        {
        case "":
        case "pile":
        case "alpha":
            holdAlpha = 0;
            face = dfAlpha;
            break;
        case "addalpha":
            holdAlpha = 0;
            face = dfAddAlpha;
            break;
        default:
            holdAlpha = 1;
            face = dfOpaque;
            break;
        }
        done = 1;
    }

    function callOnce(fn, arg)
    {
        return fn(arg);
    }

    // switch 控制表达式只能求值一次，即使最终以 else-if 形式输出。
    function cachedSwitchInvocation(value)
    {
        switch (value[0].toLowerCase())
        {
        case "first":
            first();
            break;
        case "second":
            second();
            break;
        case "third":
            third();
            break;
        default:
            fallback();
            break;
        }
    }

    // 直接方法调用形式的 switch 也只允许求值一次；部分编译器不会为它保留临时槽。
    function directSwitchInvocation(value)
    {
        switch (value.toLowerCase())
        {
        case "first":
            first();
            break;
        case "second":
            second();
            break;
        case "third":
            third();
            break;
        }
    }

    function multiplicativePrecedence(left, right)
    {
        return (left - right) \ 2 + (left + right) % 3;
    }

    function repeatedMemberReceiver()
    {
        with (getDimensions())
        {
            consume(w, h, x);
        }
    }

    function chainedSideEffectAssignment()
    {
        chainOuter = chainInner = produce();
    }

    function chainedLocalAssignment()
    {
        var local = this.cached = produce();
        consume(local);
    }

    function sharedTerminalReturn(items)
    {
        var start = items.find("---");
        if (start >= 0)
        {
            var copy = [];
            for (var i = start + 1; i < items.count; i++)
                copy.add(items[i]);
            items = copy;
        }
        return finishShared(items);
    }

    function collapseNames(first, rest*)
    {
        var firstLocal = first;
        var count = rest.count;
        return firstLocal + count;
    }

    function duplicateInferredNames(left, right)
    {
        var leftName = left.name;
        var rightName = right.name;
        consume(leftName, rightName);
    }

    // 外层 gate 内的第一个可选副作不能吞掉后续独立调用条件。
    function sequentialNestedCallGuards(textEnabled, withBack, current)
    {
        if (textEnabled)
        {
            if (withBack)
                current.comp.processReturn();
            if (current.processReturn())
            {
                var ret = showPageBreakAndClear();
                if (ret == -5)
                    ret = -4;
                else if (ret == -3)
                    ret = -2;
                return ret;
            }
        }
        return fallbackSpeed();
    }

    // 多个并列调用守卫共享继续点时，每个调用只能在自己的分支中求值一次。
    function sequentialInvocationReturnGuards(mode, leading, following)
    {
        var changed = false;
        if (mode >= 0)
        {
            changed = true;
            if (mode == 0)
            {
                if (commitLine()) return true;
            }
            else if (leading && following)
            {
                if (commitLine()) return true;
            }
            else if (leading)
            {
                if (commitLine()) return true;
            }
            else
            {
                changed = false;
            }
        }
        return changed;
    }

    // 已有对象分支结束后仍有多级早退 fallback，中间的已配置分支不能丢失。
    function configuredFallbackChain(name, options)
    {
        var layer = getEnvLayer(name);
        if (layer !== void)
        {
            if (layer.deleteFlag)
                layer = getNewLayer(name, options);
            if (layer !== void)
                return layer;
        }
        if (envinfo.layers !== void && envinfo.layers[name] !== void)
            return getNewLayer(name, options);
        if (name.substring(0, 2) == "ev" || isExistEvent(name))
            return event;
        if (name.substring(0, 3) == "lay")
            return getNewLayer(name, options);
        if (envCommands[name] !== void)
            return this;
        return void;
    }

    function defaultArgument(value = 1)
    {
        return value;
    }

    // 参数槽由函数签名声明；重新写入参数或把 void 守卫恢复成默认参数后，
    // 函数体都不能再生成同名 var。
    function parameterDeclarationOwnership(source, value)
    {
        value = source.value if value === void;
        if (source.override !== void)
            value = source.override;
        return value;
    }

    function uninitializedLocals(firstFlag, secondFlag)
    {
        var first, second;
        if (firstFlag) first = 1;
        else first = 0;
        if (secondFlag) second = 1;
        else second = 0;
        return first + second;
    }

    function cleanup(obj, hook)
    {
        if (hook !== void && isvalid obj)
            obj.removeHook(hook);
        term();
        finish();
    }

    function options(text, list)
    {
        if (text !== void && text.charAt(0) == ";" && text.charAt(1) == "!")
        {
            for (var i = 0; i < list.count; i++)
                list[i] = "." + list[i] + (list[i].indexOf("=") < 0 ? "=true" : "");
            commit(list);
        }
        after();
    }

    function optionalReturn(flag)
    {
        if (flag !== void && +flag)
            act();
        return -4;
    }

    function nestedDefault(flag, value)
    {
        angle = value === void ? flag ? 2700 : 0 : +value;
    }

    function nestedChoice(outer, first, left, right)
    {
        selected = outer ? first : ((left <= right) ? left : right);
    }

    function nestedBoolean(first, second, third)
    {
        return first || (second && third);
    }

    function nullGuard(value)
    {
        if (value == null)
            return 1;
        return 0;
    }

    function bitwiseMask(style, vertical, horizontal)
    {
        style &= ~(vertical | horizontal);
        return style;
    }

    function memberDefaults(data)
    {
        if (data.top === void) data.top = 0;
        if (data.left === void) data.left = 0;
        if (data.right === void) data.right = 0;
    }

    function sharedCases(vertical, key)
    {
        if (vertical)
        {
            if (key == KEY_DOWN) down();
            else if (key == KEY_UP) up();
            else if (key == KEY_LEFT || key == KEY_PRIOR) previous();
            else if (key == KEY_RIGHT || key == KEY_NEXT) next();
        }
        else
        {
            if (key == KEY_LEFT || key == KEY_PRIOR) previous();
            else if (key == KEY_RIGHT || key == KEY_NEXT) next();
        }
    }

    function nestedEqualityDispatch(kind, target)
    {
        if (kind == "click")
        {
            if (target == TARGET_YES) first();
            else if (target == TARGET_NO) second();
        }
        else if (kind == "key")
        {
            third();
        }
    }


    function groupedSwitch(mode, flag)
    {
        switch (mode)
        {
        case 0:
            if (flag) first();
            break;
        case 1:
        case 2:
            if (flag) second();
            else third();
            break;
        }
        afterSwitch();
    }

    function switchLoop(number, digits, smallUnits, largeUnits)
    {
        var out = "";
        var nonzero = false;
        var position = number.length - 1;
        for (var i = 0; i < number.length; i++, position--)
        {
            var unit = position & 3;
            var digit = +number[i];
            switch (unit)
            {
            case 0:
                if (digit != 0) out += digits[digit], nonzero = true;
                if (nonzero && position) out += largeUnits[position >> 2];
                nonzero = false;
                break;
            case 1:
            case 2:
            case 3:
                if (digit != 0)
                {
                    if (digit != 1 || (unit == 3 && position > 4))
                        out += digits[digit] + smallUnits[unit];
                    else
                        out += smallUnits[unit];
                    nonzero = true;
                }
                break;
            }
        }
        return out;
    }

    function equalityDefault(text, digits, point, minus)
    {
        var out = "";
        for (var i = 0; i < text.length; i++)
        {
            var ch = text[i];
            if (ch == ".") out += point;
            else if (ch == "-") out += minus;
            else if (ch >= "0" && ch <= "9") out += digits[+ch];
            else out += ch;
        }
        return out;
    }

    function delayedForInitializer(items)
    {
        var total = 0;
        var i = 0;
        var count = items.count;
        for (; i < count; i++)
        {
            if (items[i] == "") continue;
            total++;
        }
        return total;
    }

    function assignmentConditionLoop(items)
    {
        var i = 0;
        var item;
        var total = 0;
        while ((item = items[i++]) !== void)
        {
            if (item == "stop")
            {
                touch();
                break;
            }
            if (item == "") continue;
            total++;
        }
        return total;
    }

    function assignmentShortCircuitGuard(items)
    {
        var accepted = 0;
        for (var i = items.count - 1; i >= 0; i--)
        {
            var target = items[i], name;
            if (target && (name = target.name) != "")
            {
                consume(target);
                accepted++;
            }
        }
        return accepted;
    }

    function assignedReturnGuard(target, table)
    {
        var states;
        if (target == "" || table[target] === void ||
            (states = table[target].states) === void)
            return;
        consume(states);
    }

    // 正常返回由外层条件共享时，内部失败判定仍应恢复为短路早退。
    function conditionalStringEvaluation(name)
    {
        var pos;
        if ((pos = name.indexOf("$")) >= 0)
        {
            var expression = name.substr(pos + 1);
            name = name.substr(0, pos);
            if (expression != "" && !Scripts.eval(expression))
                return;
        }
        setVisible(name, true);
        return name;
    }

    // 外层条件可直接到达公共尾部时，内层载荷仍必须留在外层正文内。
    function prefixedNestedPayload(sender, name, level)
    {
        var changed = checkVPosUpdate(sender, name);
        if (changed)
        {
            currentLevel = level;
            if (currentCh !== void)
            {
                currentCh.level = level;
                syncAll();
            }
        }
        copyClipboard(name);
    }

    function conditionalLatchLoop(items)
    {
        var i = 0;
        var count = items.count;
        while (i < count)
        {
            var removed = false;
            if (items[i] == "drop")
            {
                items.erase(i);
                removed = true;
            }
            if (removed) count--;
            else i++;
        }
        return count;
    }

    function compoundDoWhile(items, limit)
    {
        var i = 0;
        do
        {
            i++;
        }
        while (i < limit && items[i] == "");
        return i;
    }

    function emptySwitchCase(items)
    {
        for (var i = 0; i < items.count; i++)
        {
            var value = items[i];
            switch (value)
            {
            case "\\":
                break;
            case "k":
                accept(value);
            default:
                continue;
            }
            after(value);
        }
    }

    // switch 的 break 只结束分派，仍须进入本轮后续处理；其余 case 则 continue。
    function escapedSwitchSharedDispatch(text)
    {
        var i = 0;
        while (i < text.length)
        {
            var ch = text.charAt(i++);
            if (ch == "\\")
            {
                if (i < text.length)
                    ch = text.charAt(i++);
                switch (ch)
                {
                case "\\":
                    break;
                case "k":
                    escaped();
                default:
                    continue;
                }
            }

            if (ch == "\n")
                newline();
            else if (ch == "%")
            {
                if (i < text.length)
                {
                    ch = text.charAt(i++);
                    percent(ch);
                }
            }
            else
                normal(ch);
        }
    }

    function guardedDelete(table, key)
    {
        if (typeof key == "String")
        {
            if (table[key] !== void)
                delete table[key];
            consume(key);
        }
    }

    function loopShortCircuitBody(items, value, all)
    {
        var i = 0;
        while (i < items.count)
        {
            var item = items[i];
            var isTick = typeof value == "Integer";
            var isNumber = typeof item.run == "Integer";
            if (all ||
                (value === void && !item.done) ||
                item.run === void ||
                (isTick && isNumber && item.run - value <= 0) ||
                (!isTick && !isNumber && (item.run == value || value == "*")))
            {
                mark(item);
                if (!interrupted)
                {
                    if (timerEnabled) queued(item);
                    else direct(item);
                }
            }
            i++;
        }
    }

    function loopTryCleanup(items)
    {
        for (var i = 0; i < items.count; i++)
        {
            beforeTry(i);
            try
            {
                consume(items[i]);
            }
            catch (e)
            {
            }
            afterTry(i);
        }
    }

    function sideEffectGuard(off, on)
    {
        if ((off && setVisible(false)) || (on && setVisible(true)))
            return -3;
        afterVisibility();
        return 0;
    }

    function sideEffectWithGuard(context, off, on)
    {
        with (context)
        {
            if ((off && setVisible(false)) || (on && setVisible(true)))
                return -3;
        }
        afterVisibility();
        return 0;
    }

    function initializedSideEffectGuard(context, mode)
    {
        var off = false, on = false;
        if (mode == 1) off = true;
        else if (mode == 2) on = true;
        else
        {
            off = context.off;
            on = context.on;
        }
        if ((off && setVisible(false)) || (on && setVisible(true)))
            return -3;
        afterVisibility();
        return 0;
    }

    function multiWayNoDefault(kind)
    {
        if (kind == 1) first();
        else if (kind == 2) second();
        afterChoice();
    }

    function gatedMultiWay(enabled, kind)
    {
        if (enabled)
        {
            if (kind == 1) first();
            else if (kind == 2) second();
        }
        afterChoice();
    }

    function tryThenElseChoice(kind)
    {
        if (kind == 1)
        {
            try
            {
                first();
            }
            catch (e)
            {
                failed(e);
            }
        }
        else if (kind == 2)
        {
            second();
        }
        afterChoice();
    }

    function nestedReverseLoops(items)
    {
        var total = 0;
        for (var i = items.count - 1; i >= 0; i--)
        {
            if (items[i] == "") continue;
            var sub = items[i];
            if (typeof sub == "Object")
            {
                for (var j = sub.count - 1; j >= 0; j--)
                {
                    if (sub[j] != "") total++;
                }
            }
        }
        return total;
    }

    function rangeBreak(text)
    {
        var count = 0;
        for (var i = 0; i < text.length; i++)
        {
            var ch = text[i];
            if (ch >= "0" && ch <= "9") count++;
            else if (ch == "." || ch == "e") break;
        }
        return count;
    }

    function longDictionary()
    {
        handlers = %["pimage" => SemanticControlFlow.loadPartialImage,
                     "ptext" => SemanticControlFlow.drawReconstructibleText];
    }

    function mixedShortCircuit(name, eye, lip)
    {
        if (name === void || name == "" ||
            (name.substr(0, 3) == "eye" && +name.substr(3) == eye) ||
            (name.substr(0, 3) == "lip" && +name.substr(3) == lip))
            accept(name);
    }

    function objectMemberGuard(links, index)
    {
        var target = links[index].object;
        if (target === void || !isvalid target || (target.visible && target.enabled))
            return index;
        return -1;
    }

    function constructorMember(data)
    {
        consume((new PSBFile(data)).root);
    }

    function guardedAlternative(ext, expected, storage)
    {
        if ((ext != "" && expected == ext) ||
            (ext == "" && probe(storage) != ""))
            return 1;
        return 0;
    }

    function guardedSharedContinuation(mode, empty, item)
    {
        if (mode > 0)
        {
            if (item == 3)
            {
                closeName(item);
                return;
            }
            else
            {
                if (mode == 1)
                {
                    if (item == 1)
                    {
                        mode = 2;
                        return 0;
                    }
                    else
                        updateName(item);
                }
                else
                    updateDisplay(item);
            }
            return;
        }
        else if (empty)
        {
            lineCheck(item);
            if (item == 2)
                return;
            emptyCheck(item);
        }

        var begin = -1;
        if (item)
            begin = probe(item);
        consume(begin);
    }

    function sharedExplicitReturn(label, expected)
    {
        if (isAuto)
        {
            currentLabel = label;
            currentLine = line;
            if (targetLine !== void)
            {
                if (label !== expected)
                    reportMismatch();
                return 1;
            }
        }

        return fallbackLabel();
    }

    // 循环内两路嵌套更新之后的状态赋值是本轮公共尾部，不能移进某一条 continue 路径。
    function sharedLoopTailAfterNestedBranches(items)
    {
        var first = true;
        var depth = 0;
        for (var i = 0; i < items.count; i++)
        {
            var begin = beginIndex(items[i]);
            var end = endIndex(items[i]);
            if (begin >= 0)
            {
                if (first)
                    openIndent();
                depth++;
            }
            else if (end >= 0)
            {
                if (depth == 1)
                    closeIndent();
                depth--;
            }
            first = false;
        }
        return depth;
    }

    function nestedSharedUpdateGuard(name)
    {
        if (name == "")
            return;
        if (name != currentName || isClear() || isShown())
        {
            currentName = name;
            updateCurrent();
        }
        finishUpdate();
    }

    function mergedObjectGate(value)
    {
        var name = (string)value;
        if (value === global || (value !== owner &&
                                 value !== cache &&
                                 value !== handlers &&
                                 visited[name] === void &&
                                 getAddr(value) == getBase(value)))
            accept(value);
    }

    function waitWithHandlers(layer, canskip, wait)
    {
        var name = "anim:" + layer.name;
        if ((canskip === void || +canskip) && clickSkipEnabled)
        {
            consume(%[
                "click" => function (target) { target.stop(); } incontextof this,
                "click_arg" => layer,
                name => function (arg) { return arg; } incontextof this,
                name + "_arg" => wait
            ]);
        }
        else
        {
            consume(%[
                name => function (arg) { return arg; } incontextof this,
                name + "_arg" => wait
            ]);
        }
        return -2;
    }

    function returnGuardContinuation(stopFlag, delayValue, now, startValue, timeValue)
    {
        if (!stopFlag && delayValue !== void)
        {
            now -= delayValue;
            if (now < 0)
                return false;
        }
        now += startValue;
        return consume(now, stopFlag || (timeValue !== void && now > timeValue));
    }

    // 分支中的连续早退不能吞掉另一分支和函数末尾的共享返回。
    function nestedPayloadReturnGuard(mode, wait)
    {
        var value;
        if (mode == "until")
        {
            value = calcWait(wait);
            if (value < 0)
            {
                resetWait();
                return 0;
            }
            saveWait(value);
            if (value < 6)
                return 0;
        }
        else
            value = +wait;
        return finishWait(value);
    }

    function equalityDefaultTrailingIf(kind, columns)
    {
        if (kind == "copy")
            first();
        else if (kind == "base")
            second();
        else
        {
            var stateName = columns[0], isrect = stateName == "rect";
            for (var i = 1; i < columns.count; i++)
            {
                var state = columns[i];
                if (state == "") continue;
                isrect |= state == "rect";
            }
            if (isrect) columns[0] = "";
            consume(stateName, columns);
        }
    }

    // 多路相等分派中的某一路可以提前返回，其余路径仍必须落入公共播放尾部。
    function equalityDispatchSharedTail(kind, enabled, hasPrefix, missing)
    {
        var found = true;
        if (kind == "disc")
        {
            if (!hasPrefix)
            {
                if (missing)
                    return;
                prepareDisc();
            }
        }
        else if (kind == "wave")
        {
            if (missing)
                found = false;
        }
        else if (kind == "midi")
        {
            prepareMidi();
        }

        if (enabled)
        {
            if (!found)
            {
                reportMissing();
                return;
            }
            playNow();
        }
        currentKind = kind;
    }

    function colorKeyDispatch(key)
    {
        if (key === void)
            key = COLOR_NONE;
        else if (typeof key == "String")
        {
            if (key == "adapt")
                key = COLOR_ADAPT;
            else if (key.length >= 7)
                key = +key;
            else
                key = +key + 50331648;
        }
        return key;
    }

    function nestedGuardFallthrough(enabled)
    {
        var count = 0;
        if (enabled)
        {
            if (count > 0)
                return true;
            count++;
        }
        consume(count);
        return false;
    }

    function conditionalBitFlags(style, italic, underline, strikeout)
    {
        style |= FONT_ITALIC if (italic);
        style |= FONT_UNDERLINE if (underline);
        style |= FONT_STRIKEOUT if (strikeout);
        return style;
    }

    function menuTracking(vis, bykey, force)
    {
        if (vis && !bykey && ignoreMenu) return;
        var old = menuShowing;
        menuShowing = !vis ? 0 : bykey ? -1 : 1;
        if (force || !old != !vis)
        {
            if (vis)
                setVisible(1);
            else
            {
                if (fullScreen) setVisible(0);
                updateMenu();
            }
        }
    }

    function conditionalPhiBranch(enabled, focus)
    {
        var base = focus ? 4 : 3;
        if (enabled)
        {
            first(base + 0);
            second(base + 1);
            if (focus) third(base + 2);
        }
        afterChoice();
    }

    function nestedCleanup(info)
    {
        var result = void;
        if (info != void)
        {
            if (info.text !== void)
                result = info.text;
            if (info.enabled)
            {
                if (info.count >= 0)
                    info.count++;
                info.enabled = void;
            }
        }
        return result;
    }

    function arrayLiteralForward(info)
    {
        consume([info.first, info.second, info.third]);
    }

    function memberLookupCleanup(info, dress)
    {
        if (dress !== void &&
            (info.dresses == void || info.dresses[dress] == void))
            dress = void;
